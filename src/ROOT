chapter GST
session GST = "HOL" +
  description 
    "A framework for building Generalized Set Theories in Isabelle/HOL"
  (*HTML presentation is requested by the Makefile's "isabelle build -P html",
    not by browser_info here, so that this session declaration stays in the
    shape the AFP expects.*)
  options
    [timeout = 600]
  sessions
    "HOL-Eisbach"
    "ZFC_in_HOL"
  directories
    Exception
    Founder
    Functions
    "Functions/Model"
    GZF
    "GZF/Model"
    ModelKit
    OPair
    "OPair/Model"
    Ordinal
    "Ordinal/Model"
    Relations
  theories
    "Founder/Test"
    "Founder/GST_Examples"
    (*Theories no other theory imports, so naming Founder/Test alone left
      them unbuilt -- and therefore unchecked.*)
    "GZF/Successor"
    "Functions/FunctionSpace"
    "Ordinal/DependentOrd"
  document_files
    "root.tex"
